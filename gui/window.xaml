<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tartarus" Width="1130" Height="820" MinWidth="940" MinHeight="690"
        WindowStartupLocation="CenterScreen" Background="#101014" Foreground="#F1F0F5"
        FontFamily="Segoe UI" FontSize="14" UseLayoutRounding="True">
  <Window.Resources>
    <SolidColorBrush x:Key="Muted" Color="#A6A4B4"/>
    <Style TargetType="Button">
      <Setter Property="Foreground" Value="#E5E3ED"/><Setter Property="Background" Value="#25252E"/>
      <Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="14,10"/>
      <Setter Property="Cursor" Value="Hand"/><Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
          <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.8"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.4"/></Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#FF8879"/><Setter TargetName="Surface" Property="BorderThickness" Value="2"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="SmallButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Padding" Value="10,6"/><Setter Property="FontSize" Value="12"/>
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Foreground" Value="#F1F0F5"/><Setter Property="Background" Value="#1B1B23"/>
      <Setter Property="CaretBrush" Value="#FF8879"/><Setter Property="BorderBrush" Value="#3B3947"/>
      <Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="14,12"/>
      <Setter Property="SelectionBrush" Value="#8A493F"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox">
        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
          <ScrollViewer x:Name="PART_ContentHost" Focusable="False" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" Foreground="{TemplateBinding Foreground}" FontSize="{TemplateBinding FontSize}" FontFamily="{TemplateBinding FontFamily}" Padding="{TemplateBinding Padding}"/>
        </Border>
      </ControlTemplate></Setter.Value></Setter>
      <Style.Triggers><Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="BorderBrush" Value="#FF8879"/></Trigger></Style.Triggers>
    </Style>
    <Style TargetType="ComboBox">
      <Setter Property="Foreground" Value="#E5E3ED"/><Setter Property="Background" Value="#2D2C37"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox">
        <Grid>
          <ToggleButton Focusable="False" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" ClickMode="Press">
            <ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="#2D2C37" CornerRadius="6" BorderBrush="#45404E" BorderThickness="1"><TextBlock Text="⌄" Foreground="#C8C3D5" HorizontalAlignment="Right" Margin="0,2,9,3"/></Border></ControlTemplate></ToggleButton.Template>
          </ToggleButton>
          <ContentPresenter Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" Margin="10,8,26,8" IsHitTestVisible="False" VerticalAlignment="Center"/>
          <Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
            <Border Background="#2D2C37" BorderBrush="#45404E" BorderThickness="1" CornerRadius="6" Padding="4" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
              <ScrollViewer MaxHeight="240"><ItemsPresenter/></ScrollViewer>
            </Border>
          </Popup>
        </Grid>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="ComboBoxItem">
      <Setter Property="Foreground" Value="#E5E3ED"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem">
        <Border x:Name="ItemSurface" Background="Transparent" CornerRadius="4" Padding="8"><ContentPresenter/></Border>
        <ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="ItemSurface" Property="Background" Value="#49424F"/></Trigger></ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="ScrollBar">
      <Setter Property="Width" Value="8"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar">
        <Grid Background="Transparent">
          <Track x:Name="PART_Track" IsDirectionReversed="True" Orientation="Vertical">
            <Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageUpCommand" Focusable="False"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.DecreaseRepeatButton>
            <Track.Thumb><Thumb><Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="#484450" CornerRadius="4" Margin="1"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
            <Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageDownCommand" Focusable="False"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.IncreaseRepeatButton>
          </Track>
        </Grid>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
  </Window.Resources>
  <Grid Background="#101014">
    <Grid.RowDefinitions><RowDefinition Height="76"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Border Grid.Row="0" BorderBrush="#292832" BorderThickness="0,0,0,1" Padding="26,0">
      <DockPanel VerticalAlignment="Center">
        <Border DockPanel.Dock="Left" Width="32" Height="32" Background="#F37562" CornerRadius="9" Margin="0,0,12,0">
          <TextBlock Text="T" Foreground="#171419" FontSize="23" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <StackPanel DockPanel.Dock="Left"><TextBlock Text="TARTARUS" FontSize="19" FontWeight="SemiBold"/><TextBlock Text="Маленькая модель. Собственные слова." FontSize="11" Foreground="{StaticResource Muted}"/></StackPanel>
        <Border DockPanel.Dock="Right" Background="#1B2A25" CornerRadius="12" Padding="12,5" HorizontalAlignment="Right"><TextBlock Text="●  Локально · Brainfuck" Foreground="#9CD8B7" FontSize="12"/></Border>
      </DockPanel>
    </Border>
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions><ColumnDefinition Width="272"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border Background="#17171D" BorderBrush="#292832" BorderThickness="0,0,1,0" Padding="22,24">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel>
            <TextBlock Text="МОДЕЛЬ" Foreground="{StaticResource Muted}" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,12"/>
            <Border Background="#22222B" CornerRadius="12" Padding="16">
              <StackPanel><TextBlock x:Name="ModelTitle" Text="Who v1" FontSize="22" FontWeight="SemiBold"/>
                <TextBlock x:Name="ModelDetails" Text="30 слов · контекст из 4 слов" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,5,0,14"/>
                <ComboBox x:Name="ArmBox" SelectedIndex="3" Padding="7,5" FontSize="12" AutomationProperties.Name="Вариант модели">
                  <ComboBoxItem Content="Word 80 · основная" Tag="crossfit"/><ComboBoxItem Content="Word 80 · сравнение" Tag="resubstitution"/><ComboBoxItem Content="Who v1 · вопросы" Tag="who"/><ComboBoxItem Content="Диалог · 8 слов" Tag="copy8"/>
                </ComboBox>
                <TextBlock x:Name="ArmDescription" Text="Выбрана по переносу между учебными группами." Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,10,0,0"/>
              </StackPanel>
            </Border>
            <TextBlock x:Name="ExamplesTitle" Text="ПОПРОБУЙ ВОПРОС" Foreground="{StaticResource Muted}" FontSize="11" FontWeight="SemiBold" Margin="0,26,0,10"/>
            <StackPanel x:Name="ExamplesPanel"/>
            <TextBlock Text="ДОСТУПНЫЕ СЛОВА" Foreground="{StaticResource Muted}" FontSize="11" FontWeight="SemiBold" Margin="0,26,0,5"/>
            <TextBlock Text="Нажми на слово, чтобы добавить его." Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,10"/>
            <WrapPanel x:Name="VocabularyPanel"/>
            <TextBlock x:Name="ScopeNote" Text="" Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" LineHeight="18" Margin="0,22,0,0"/>
          </StackPanel>
        </ScrollViewer>
      </Border>
      <Grid Grid.Column="1" Margin="30,24,30,24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid Margin="0,0,0,20">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <StackPanel><TextBlock x:Name="IntroTitle" Text="Кто, что и где?" FontSize="27" FontWeight="SemiBold"/><TextBlock x:Name="IntroDescription" Text="" TextWrapping="Wrap" Foreground="{StaticResource Muted}" FontSize="13" Margin="0,6,0,0"/></StackPanel>
          <Button x:Name="ClearButton" Grid.Column="1" Content="Очистить" Style="{StaticResource SmallButton}" VerticalAlignment="Top" Margin="14,5,0,0" ToolTip="Очистить историю в окне. Файлы запусков сохранятся."/>
        </Grid>
        <ScrollViewer x:Name="HistoryScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,9,0">
          <StackPanel x:Name="HistoryPanel">
            <Border x:Name="WelcomeCard" Background="#1A1A22" BorderBrush="#302D3B" BorderThickness="1" CornerRadius="14" Padding="25" Margin="0,20,0,20">
              <StackPanel><TextBlock x:Name="WelcomeTitle" Text="Задай первый вопрос." FontSize="21" FontWeight="SemiBold" Margin="0,0,0,12"/>
                <TextBlock x:Name="WelcomeDescription" Text="" Foreground="#C0BDCD" TextWrapping="Wrap" LineHeight="22"/>
                <Border Background="#25232D" CornerRadius="8" Padding="15" Margin="0,20,0,16"><TextBlock x:Name="WelcomeExample" Text="who carries a red book" TextWrapping="Wrap" FontFamily="Consolas" FontSize="20" Foreground="#FFAA98"/></Border>
                <TextBlock x:Name="WelcomeLegend" Text="Серый текст — вопрос. Светлый — ответ модели." Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap"/>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="2" Margin="0,16,0,14">
          <ProgressBar x:Name="BusyBar" Height="3" IsIndeterminate="True" Visibility="Collapsed" Foreground="#F37562" Background="#292832" Margin="0,0,0,10"/>
          <TextBlock x:Name="StatusText" Text="Готов к запуску" Foreground="#9CD8B7" FontSize="12" TextWrapping="Wrap"/>
          <WrapPanel x:Name="FollowupPanel" Visibility="Collapsed" Margin="0,8,0,0">
            <TextBlock Text="Короткий второй вопрос:" Foreground="{StaticResource Muted}" FontSize="12" VerticalAlignment="Center" Margin="0,0,9,0"/>
            <Button x:Name="AskWhatButton" Content="what" Style="{StaticResource SmallButton}" FontFamily="Consolas" Margin="0,0,6,0"/>
            <Button x:Name="AskWhereButton" Content="where" Style="{StaticResource SmallButton}" FontFamily="Consolas"/>
          </WrapPanel>
        </StackPanel>
        <StackPanel Grid.Row="3">
          <TextBox x:Name="PromptBox" Text="who carries a red book" FontSize="18" MaxLength="98" Height="53" VerticalContentAlignment="Center" AutomationProperties.Name="Ввод для модели"/>
          <Grid Margin="0,12,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center"><TextBlock x:Name="EnterHint" Text="Enter — спросить" Foreground="{StaticResource Muted}" FontSize="11"/><TextBlock x:Name="LengthText" Text="21 / 98 · строчные английские слова" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,3,0,0"/></StackPanel>
            <Button x:Name="StopButton" Grid.Column="1" Content="Остановить" Visibility="Collapsed" Margin="0,0,10,0"/>
            <Button x:Name="SendButton" Grid.Column="2" Content="Спросить →" Background="#F37562" Foreground="#19151A" FontWeight="SemiBold" Padding="22,12" IsDefault="False"/>
          </Grid>
        </StackPanel>
      </Grid>
    </Grid>
  </Grid>
</Window>
